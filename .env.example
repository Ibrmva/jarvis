# JARVIS configuration
# Copy to .env and edit. Every value below is the code default.

JARVIS_NAME=JARVIS

# Optional HTTPS for LAN/mobile microphone access. Use a certificate trusted
# by the device browser, with the LAN hostname/IP in its subject alternative names.
# JARVIS_SSL_CERTFILE=./certs/jarvis.pem
# JARVIS_SSL_KEYFILE=./certs/jarvis-key.pem

# Ollama endpoint. Keep it on loopback unless you have added authentication.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model tiers used by the router.
FAST_MODEL=qwen3.5:2b
ADVANCED_MODEL=qwen3.5:4b
DEFAULT_MODEL_MODE=auto

# SQLite file. Directory is created on first start.
DATABASE_PATH=./data/jarvis.db

# Conversation turns replayed to the model on each request.
MAX_HISTORY_MESSAGES=20

# Per-request timeout for /api/chat, in seconds.
REQUEST_TIMEOUT_SECONDS=240

# Seconds Ollama keeps a model resident after a reply.
# 0 unloads immediately (saves RAM, adds a reload on every turn);
# "5m" keeps it warm (lower latency, higher idle RAM).
OLLAMA_KEEP_ALIVE=0

# Context window.
NUM_CTX=4096

# Speech-to-text (voice input). The GGML weights are not committed - fetch them:
#   ./scripts/fetch_models.sh
# Override these to use a different ggml model or an explicit whisper-cli binary.
# WHISPER_MODEL_PATH=./models/whisper/ggml-base-q5_1.bin
# WHISPER_EXECUTABLE=/opt/homebrew/bin/whisper-cli
